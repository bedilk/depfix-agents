# Copy to .env and fill in. `.env` is gitignored; this example is committed.

# --- LLM (required for fix generation and release-note classification) ---
GOOGLE_API_KEY=            # https://aistudio.google.com/app/apikey
# GEMINI_MODEL=gemini-2.5-flash
# LLM_FALLBACK_MODEL=gemini-2.5-pro   # escalate once when flash lands no edit
# LLM_PROVIDER=gemini                 # or: ollama (local, no key needed)
# OLLAMA_MODEL=qwen2.5-coder:7b

# --- Database (docker compose default) ---
# DATABASE_URL=postgresql+psycopg://depfix:depfix@localhost:5432/depfix

# --- GitHub App (only for remote-repo scan/fix/PR; local paths work without) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem

# --- Optional knobs ---
# PLAN_IMPACT_CHECK_ENABLED=true
# VERIFY_ENABLED=true
